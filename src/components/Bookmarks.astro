<section class="bookmark-card" aria-label="Bookmark manager">
  <form id="add-bookmark">
    <div class="field">
      <label for="url">Link to save</label>
      <input
        id="url"
        name="url"
        type="text"
        inputmode="url"
        autocomplete="url"
        spellcheck="false"
        placeholder="example.com or https://example.com"
        required
      />
    </div>
    <button type="submit">Add bookmark</button>
  </form>

  <p class="hint">Paste a website address with or without <code>https://</code>. We’ll tidy it up and make a short slug.</p>
  <p id="bookmark-status" role="status" aria-live="polite"></p>

  <p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

  <div id="list-header" hidden>
    <h2 class="list-title">Saved bookmarks</h2>
    <button id="clear-all" type="button" class="clear">Clear all</button>
  </div>

  <ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite"></ul>
</section>

<script>
  import {
    BOOKMARKS_STORAGE_KEY,
    formatBookmark,
    loadBookmarks,
    normalizeUrl,
    type Bookmark,
  } from '../lib/bookmarks.ts';

  const form = document.querySelector<HTMLFormElement>('#add-bookmark');
  const urlInput = document.querySelector<HTMLInputElement>('#url');
  const list = document.querySelector<HTMLUListElement>('#bookmark-list');
  const emptyState = document.querySelector<HTMLParagraphElement>('#empty-state');
  const listHeader = document.querySelector<HTMLDivElement>('#list-header');
  const clearAll = document.querySelector<HTMLButtonElement>('#clear-all');
  const status = document.querySelector<HTMLParagraphElement>('#bookmark-status');

  if (form && urlInput && list && emptyState && listHeader && clearAll && status) {
    let bookmarks: Bookmark[] = [];

    function createSlug(usedSlugs: Set<string>): string {
      const alphabet = '0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ';
      let slug: string;

      do {
        let suffix = '';
        while (suffix.length < 4) {
          for (const byte of crypto.getRandomValues(new Uint8Array(8))) {
            if (byte < 248) suffix += alphabet[byte % alphabet.length];
            if (suffix.length === 4) break;
          }
        }
        slug = `mona-${suffix}`;
      } while (usedSlugs.has(slug));

      return slug;
    }

    function renderBookmarks(): void {
      list.replaceChildren();
      emptyState.hidden = bookmarks.length > 0;
      listHeader.hidden = bookmarks.length === 0;

      for (const bookmark of bookmarks) {
        const row = document.createElement('li');
        row.className = 'bookmark';

        const line = document.createElement('span');
        line.className = 'bookmark-line';

        const link = document.createElement('a');
        link.className = 'url';
        link.href = bookmark.url;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.textContent = bookmark.url;

        const slug = document.createElement('span');
        slug.className = 'slug';
        slug.textContent = bookmark.slug;

        line.append(link, document.createTextNode(' :: '), slug);

        const copy = document.createElement('button');
        copy.className = 'copy';
        copy.type = 'button';
        copy.textContent = 'Copy';
        copy.setAttribute('aria-label', `Copy ${bookmark.slug}`);
        copy.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(bookmark.slug);
            status.textContent = `Copied ${bookmark.slug}.`;
          } catch {
            status.textContent = 'Could not copy the slug. Check clipboard permissions and try again.';
          }
        });

        row.append(line, copy);
        list.append(row);
      }
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      status.textContent = '';

      let url: string;
      try {
        url = normalizeUrl(urlInput.value);
      } catch {
        status.textContent = 'Enter a valid HTTP or HTTPS web address.';
        urlInput.focus();
        return;
      }

      let slug: string;
      try {
        slug = createSlug(new Set(bookmarks.map((bookmark) => bookmark.slug)));
      } catch {
        status.textContent = 'Could not generate a bookmark slug. Please try again.';
        return;
      }

      const bookmark = { url, slug };
      const updatedBookmarks = [...bookmarks, bookmark];
      try {
        localStorage.setItem(BOOKMARKS_STORAGE_KEY, JSON.stringify(updatedBookmarks));
      } catch {
        status.textContent = 'Could not save this bookmark in browser storage.';
        return;
      }

      bookmarks = updatedBookmarks;
      renderBookmarks();
      urlInput.value = '';
      status.textContent = `Saved ${formatBookmark(bookmark)}.`;
      urlInput.focus();
    });

    clearAll.addEventListener('click', () => {
      if (!window.confirm('Clear all saved bookmarks?')) return;

      try {
        localStorage.removeItem(BOOKMARKS_STORAGE_KEY);
      } catch {
        status.textContent = 'Could not clear bookmarks from browser storage.';
        return;
      }

      bookmarks = [];
      renderBookmarks();
      status.textContent = 'All bookmarks cleared.';
    });

    try {
      bookmarks = loadBookmarks(localStorage.getItem(BOOKMARKS_STORAGE_KEY));
    } catch {
      status.textContent = 'Could not access saved bookmarks in browser storage.';
    }

    renderBookmarks();
  }
</script>

