---
// Bookmark behavior runs in the client-side script below so the static build
// never accesses browser APIs.
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="url"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>
<p id="bookmark-status" role="status" aria-live="polite"></p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  interface Bookmark {
    url: string;
    slug: string;
  }

  const storageKey = 'mona-bookmarks';
  const form = document.querySelector<HTMLFormElement>('#add-bookmark');
  const urlInput = document.querySelector<HTMLInputElement>('#url');
  const list = document.querySelector<HTMLUListElement>('#bookmark-list');
  const emptyState = document.querySelector<HTMLParagraphElement>('#empty-state');
  const listHeader = document.querySelector<HTMLDivElement>('#list-header');
  const clearAll = document.querySelector<HTMLButtonElement>('#clear-all');
  const status = document.querySelector<HTMLParagraphElement>('#bookmark-status');

  if (form && urlInput && list && emptyState && listHeader && clearAll && status) {
    let bookmarks: Bookmark[] = [];

    function isBookmark(value: unknown): value is Bookmark {
      if (typeof value !== 'object' || value === null) return false;
      const candidate = value as Record<string, unknown>;
      if (typeof candidate.url !== 'string'
        || typeof candidate.slug !== 'string'
        || !candidate.slug.startsWith('mona-')) {
        return false;
      }

      try {
        const parsedUrl = new URL(candidate.url);
        return parsedUrl.protocol === 'http:' || parsedUrl.protocol === 'https:';
      } catch {
        return false;
      }
    }

    function createSlug(): string {
      const randomValue = crypto.getRandomValues(new Uint32Array(1))[0];
      const suffix = Math.floor((randomValue / 0x100000000) * 36 ** 6)
        .toString(36)
        .padStart(6, '0');
      return `mona-${suffix}`;
    }

    function renderBookmarks(): void {
      list.replaceChildren();
      emptyState.hidden = bookmarks.length > 0;
      listHeader.hidden = bookmarks.length === 0;

      for (const bookmark of bookmarks) {
        const row = document.createElement('li');
        row.className = 'bookmark';

        const link = document.createElement('a');
        link.className = 'url';
        link.href = bookmark.url;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.textContent = bookmark.url;

        const slug = document.createElement('span');
        slug.className = 'slug';
        slug.textContent = bookmark.slug;

        const copy = document.createElement('button');
        copy.className = 'copy';
        copy.type = 'button';
        copy.textContent = 'Copy';
        copy.setAttribute('aria-label', `Copy ${bookmark.slug}`);
        copy.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(bookmark.slug);
            status.textContent = `Copied ${bookmark.slug}.`;
          } catch {
            status.textContent = 'Could not copy the slug. Check clipboard permissions and try again.';
          }
        });

        row.append(link, slug, copy);
        list.append(row);
      }
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      status.textContent = '';

      const originalUrl = urlInput.value.trim();
      let parsedUrl: URL;
      try {
        parsedUrl = new URL(originalUrl);
      } catch {
        status.textContent = 'Enter a valid web URL, such as https://example.com.';
        urlInput.focus();
        return;
      }

      if (parsedUrl.protocol !== 'http:' && parsedUrl.protocol !== 'https:') {
        status.textContent = 'Only HTTP and HTTPS links can be saved.';
        urlInput.focus();
        return;
      }

      let slug = createSlug();
      while (bookmarks.some((bookmark) => bookmark.slug === slug)) {
        slug = createSlug();
      }

      const bookmark = { url: originalUrl, slug };
      const updatedBookmarks = [...bookmarks, bookmark];
      try {
        localStorage.setItem(storageKey, JSON.stringify(updatedBookmarks));
      } catch {
        status.textContent = 'Could not save this bookmark in browser storage.';
        return;
      }

      bookmarks = updatedBookmarks;
      renderBookmarks();
      urlInput.value = '';
      status.textContent = `Saved with slug ${slug}.`;
      urlInput.focus();
    });

    clearAll.addEventListener('click', () => {
      if (!window.confirm('Clear all saved bookmarks?')) return;

      try {
        localStorage.removeItem(storageKey);
      } catch {
        status.textContent = 'Could not clear bookmarks from browser storage.';
        return;
      }

      bookmarks = [];
      renderBookmarks();
      status.textContent = 'All bookmarks cleared.';
    });

    try {
      const saved = localStorage.getItem(storageKey);
      if (saved !== null) {
        const parsed: unknown = JSON.parse(saved);
        if (!Array.isArray(parsed)) throw new Error('Stored bookmarks must be an array.');
        const restored = parsed.filter(isBookmark);
        if (restored.length !== parsed.length) throw new Error('Stored bookmarks are invalid.');
        bookmarks = restored;
      }
    } catch {
      status.textContent = 'Could not load saved bookmarks from browser storage.';
    }

    renderBookmarks();
  }
</script>
